{
  "search": [
    { "uid": "api-overview", "title": "API overview", "type": "dash-db", "url": "/d/api-overview/api-overview", "folderTitle": "Services" },
    { "uid": "k8s-pods", "title": "Kubernetes / Pods", "type": "dash-db", "url": "/d/k8s-pods/kubernetes-pods", "folderTitle": "Platform" },
    { "uid": "legacy-node", "title": "Node (legacy)", "type": "dash-db", "url": "/d/legacy-node/node-legacy" }
  ],
  "dashboards": {
    "api-overview": {
      "meta": { "url": "/d/api-overview/api-overview", "folderTitle": "Services", "slug": "api-overview" },
      "dashboard": {
        "uid": "api-overview",
        "title": "API overview",
        "schemaVersion": 39,
        "__inputs": [{ "name": "DS_PROMETHEUS", "type": "datasource", "pluginId": "prometheus" }],
        "templating": {
          "list": [
            { "type": "datasource", "name": "datasource", "query": "prometheus" },
            { "type": "datasource", "name": "logs", "query": "loki" },
            {
              "type": "query",
              "name": "job",
              "datasource": { "type": "prometheus", "uid": "${datasource}" },
              "query": { "query": "label_values(prometheus_http_requests_total, job)", "refId": "PrometheusVariableQueryEditor-VariableQuery" }
            },
            {
              "type": "query",
              "name": "handler",
              "datasource": "${DS_PROMETHEUS}",
              "query": "label_values(prometheus_http_requests_total{job=~\"$job\"}, handler)"
            },
            { "type": "interval", "name": "interval", "query": "1m,5m,10m" }
          ]
        },
        "panels": [
          {
            "id": 1,
            "type": "timeseries",
            "title": "Request rate by handler",
            "datasource": { "type": "prometheus", "uid": "${datasource}" },
            "targets": [
              {
                "refId": "A",
                "expr": "sum by (handler) (rate(prometheus_http_requests_total{job=~\"$job\", handler=~\"$handler\"}[$__rate_interval]))",
                "legendFormat": "{{handler}}"
              }
            ]
          },
          {
            "id": 2,
            "type": "timeseries",
            "title": "p99 latency",
            "datasource": { "type": "prometheus", "uid": "${datasource}" },
            "targets": [
              {
                "refId": "A",
                "expr": "histogram_quantile(0.99, sum by (le, handler) (rate(prometheus_http_request_duration_seconds_bucket{job=~\"$job\"}[[[interval]]])))",
                "legendFormat": "{{handler}}"
              }
            ]
          },
          {
            "id": 3,
            "type": "row",
            "title": "Details",
            "collapsed": false,
            "panels": []
          },
          {
            "id": 4,
            "type": "timeseries",
            "title": "Errors vs logs",
            "datasource": { "type": "datasource", "uid": "-- Mixed --" },
            "targets": [
              {
                "refId": "A",
                "datasource": { "type": "prometheus", "uid": "prom-main" },
                "expr": "sum without (instance, pod) (rate(prometheus_http_requests_total{code=~\"5..\"}[5m]))"
              },
              {
                "refId": "B",
                "datasource": { "type": "loki", "uid": "loki-main" },
                "expr": "sum(count_over_time({app=\"api\"} |= \"error\" [5m]))"
              }
            ]
          },
          {
            "id": 5,
            "type": "row",
            "title": "Internals (collapsed)",
            "collapsed": true,
            "panels": [
              {
                "id": 6,
                "type": "timeseries",
                "title": "Goroutines",
                "datasource": "${DS_PROMETHEUS}",
                "targets": [{ "refId": "A", "expr": "go_goroutines{job=~\"$job\"}", "legendFormat": "{{instance}}" }]
              },
              {
                "id": 7,
                "type": "stat",
                "title": "Build info",
                "targets": [{ "refId": "A", "expr": "count by (version) (prometheus_build_info) * on() group_left() scalar(up{job=\"prometheus\"})" }]
              },
              {
                "id": 8,
                "gridPos": { "h": 8, "w": 12, "x": 0, "y": 30 },
                "libraryPanel": { "uid": "lib-heap", "name": "Heap in use" }
              }
            ]
          },
          {
            "id": 9,
            "type": "logs",
            "title": "Recent errors",
            "datasource": { "type": "loki", "uid": "${logs}" },
            "targets": [{ "refId": "A", "expr": "{app=\"api\"} |= \"error\" | json" }]
          },
          {
            "id": 10,
            "type": "table",
            "title": "Slow queries",
            "datasource": { "type": "grafana-postgresql-datasource", "uid": "pg" },
            "targets": [{ "refId": "A", "rawSql": "select * from slow_queries" }]
          },
          {
            "id": 11,
            "type": "timeseries",
            "title": "Broken query",
            "datasource": { "type": "prometheus", "uid": "prom-main" },
            "targets": [{ "refId": "A", "expr": "sum by (pod) (rate(container_memory_working_set_bytes{namespace=\"x\"}[5m]) $__unknown(3)" }]
          }
        ]
      }
    },
    "k8s-pods": {
      "meta": { "url": "/d/k8s-pods/kubernetes-pods", "folderTitle": "Platform" },
      "dashboard": {
        "uid": "k8s-pods",
        "title": "Kubernetes / Pods",
        "templating": { "list": [] },
        "panels": [
          {
            "id": 1,
            "type": "timeseries",
            "title": "CPU by pod",
            "datasource": { "type": "prometheus", "uid": "prom-main" },
            "targets": [
              {
                "refId": "A",
                "expr": "sum by (namespace, pod) (rate(container_cpu_usage_seconds_total{container!=\"\"}[5m])) * on (namespace, pod) group_left(node) kube_pod_info{node=~\"$node\"}",
                "legendFormat": "{{pod}} on {{node}}"
              }
            ]
          },
          {
            "id": 2,
            "type": "timeseries",
            "title": "Network by interface",
            "datasource": { "type": "prometheus", "uid": "prom-main" },
            "targets": [
              { "refId": "A", "expr": "sum by (device) (rate({__name__=~\"node_network_(receive|transmit)_bytes_total\", device!=\"lo\"}[5m]))" }
            ]
          }
        ]
      }
    },
    "legacy-node": {
      "meta": { "url": "/d/legacy-node/node-legacy" },
      "dashboard": {
        "uid": "legacy-node",
        "title": "Node (legacy)",
        "schemaVersion": 14,
        "rows": [
          {
            "title": "CPU",
            "panels": [
              {
                "id": 1,
                "title": "CPU busy",
                "datasource": "Prometheus",
                "targets": [{ "expr": "100 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100" }]
              },
              {
                "id": 2,
                "title": "Scrape duration",
                "datasource": null,
                "targets": [{ "expr": "scrape_duration_seconds" }]
              }
            ]
          }
        ]
      }
    }
  },
  "libraryElements": {
    "lib-heap": {
      "result": {
        "uid": "lib-heap",
        "name": "Heap in use",
        "model": {
          "type": "timeseries",
          "title": "Heap in use",
          "datasource": { "type": "prometheus", "uid": "prom-main" },
          "targets": [{ "refId": "A", "expr": "go_memstats_heap_inuse_bytes{job=~\"$job\"}", "legendFormat": "{{instance}}" }]
        }
      }
    }
  },
  "alertRules": [
    {
      "uid": "high-error-rate",
      "title": "High 5xx rate",
      "folderUID": "services",
      "ruleGroup": "api",
      "data": [
        {
          "refId": "A",
          "datasourceUid": "prom-main",
          "model": {
            "expr": "sum by (handler) (rate(prometheus_http_requests_total{code=~\"5..\"}[5m])) > 1",
            "datasource": { "type": "prometheus", "uid": "prom-main" }
          }
        },
        { "refId": "B", "datasourceUid": "__expr__", "model": { "type": "threshold", "expression": "A" } }
      ]
    },
    {
      "uid": "log-errors",
      "title": "Error logs",
      "data": [
        {
          "refId": "A",
          "datasourceUid": "loki-main",
          "model": { "expr": "sum(count_over_time({app=\"api\"} |= \"panic\" [5m]))", "datasource": { "type": "loki", "uid": "loki-main" } }
        }
      ]
    }
  ]
}
